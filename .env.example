# BizDesk - Environment Variables
# Copy to .env and adjust values for your environment

PROJECT_NAME="BizDesk"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database
DATABASE_URL="sqlite:///./bizdesk.db"

# Business Presets (clinic | salon | coaching)
DEFAULT_BUSINESS_TYPE="clinic"
DEFAULT_CURRENCY="INR"
TAX_RATE_PERCENTAGE=18.0

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
